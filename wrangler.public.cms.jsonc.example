{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "webaidesk",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "dist-public",
  "vars": {
    "ENVIRONMENT": "production"
  },
  "d1_databases": [{
    "binding": "CMS_DB",
    "database_name": "aidesk-studio-staging",
    "database_id": "<STAGING_D1_ID>"
  }],
  "r2_buckets": [{
    "binding": "RELEASES",
    "bucket_name": "aidesk-releases"
  }, {
    "binding": "CMS_MEDIA",
    "bucket_name": "aidesk-studio-media-staging"
  }]
}
