{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "webaidesk",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "dist-public",
  "vars": {
    "ENVIRONMENT": "production"
  },
  // !! NOT the deploy source of truth. Production is deployed WITHOUT --config (`wrangler pages deploy dist-public --project-name
  // webaidesk --branch main`), so the Pages DASHBOARD bindings apply: CMS_DB, CMS_MEDIA, RELEASES (downloads + update feed),
  // BUG_REPORTS_DB, BUG_REPORTS, secret IP_HASH_SALT. Deploying with --config this file would DROP RELEASES/CMS_*.
  // Bug report V1 intake (POST /api/bug-report) uses its own D1 "aidesk-bug-reports" (bound as BUG_REPORTS_DB, added 2026-11-18).
  "d1_databases": [{
    "binding": "BUG_REPORTS_DB",
    "database_name": "aidesk-bug-reports",
    "database_id": "a766913c-9f8d-4e0b-a628-9f846ea2ab41"
  }],
  // PRIVATE bucket: no public access, no r2.dev, no custom domain.
  "r2_buckets": [{
    "binding": "BUG_REPORTS",
    "bucket_name": "aidesk-bug-reports"
  }]
}
