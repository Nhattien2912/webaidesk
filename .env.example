# Copy to .env.local (gitignored) for local overrides, or set these in the Cloudflare Pages
# project (Settings -> Environment variables). All are public build-time values: never put
# secrets in VITE_* variables. Leave a value empty if it has not been verified yet.

# Public site origin, used for the canonical link (e.g. https://aidesk.example)
VITE_SITE_URL=
# Support / privacy contact shown on the site
VITE_CONTACT_EMAIL=
# YouTube URL of the intro video (button stays "sắp có" while empty)
VITE_INTRO_VIDEO_URL=

# Social links (https only). YouTube and Facebook default to the official channels below when
# left empty; set a value only to override them. GitHub has no official URL yet: empty = shown
# as "Liên kết sẽ được cập nhật".
#   YouTube:  https://www.youtube.com/@NhattienIT
#   Facebook: https://www.facebook.com/profile.php?id=61595065515012
VITE_SOCIAL_YOUTUBE_URL=
VITE_SOCIAL_FACEBOOK_URL=
VITE_SOCIAL_GITHUB_URL=

# Release manifest. Empty = /api/releases/latest (Pages Function over server/releaseCatalog.ts).
# A static manifest URL (legacy, e.g. /releases/latest.json) is still accepted.
VITE_RELEASE_MANIFEST_URL=
# Comma-separated hosts allowed for installer URLs. Empty = webaidesk.pages.dev (production).
VITE_DOWNLOAD_ALLOWED_HOSTS=
# Keep false for public releases; unsigned installers stay blocked
VITE_ALLOW_UNSIGNED_DOWNLOAD=false

# Waitlist API (Pages Function) and optional Cloudflare Turnstile site key
VITE_WAITLIST_ENDPOINT=/api/waitlist
VITE_TURNSTILE_SITE_KEY=
