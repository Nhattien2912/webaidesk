{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "webaidesk-studio-staging",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "dist",
  "vars": {
    "ENVIRONMENT": "staging",
    "ACCESS_TEAM_DOMAIN": "REPLACE_WITH_TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_STAGING_AUD",
    "ACCESS_ALLOWED_IDENTITIES": "REPLACE_WITH_OWNER_EMAIL",
    "CMS_ALLOWED_ORIGINS": "https://REPLACE_WITH_STAGING_HOST",
    "CMS_ALLOWED_IMAGE_HOSTS": "i.ytimg.com,REPLACE_WITH_MEDIA_HOST",
    "CMS_ALLOWED_DOWNLOAD_HOSTS": "REPLACE_WITH_DOWNLOAD_HOST",
    "CMS_MEDIA_RETENTION_DAYS": "30"
  },
  "d1_databases": [{
    "binding": "CMS_DB",
    "database_name": "aidesk-studio-staging",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{
    "binding": "CMS_MEDIA",
    "bucket_name": "aidesk-studio-media-staging"
  }],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
