{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aidesk-studio-private",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "dist-private",
  "vars": {
    "ENVIRONMENT": "staging",
    "CMS_ADMIN_ENABLED": "false",
    "ACCESS_TEAM_DOMAIN": "<ACCESS_TEAM>.cloudflareaccess.com",
    "ACCESS_ALLOWED_IDENTITIES": "<OWNER_EMAIL>"
  },
  "d1_databases": [{
    "binding": "CMS_DB",
    "database_name": "aidesk-studio-staging",
    "database_id": "<STAGING_D1_ID>",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{
    "binding": "CMS_MEDIA",
    "bucket_name": "aidesk-studio-media-staging"
  }]
}
